<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.LazyDashboard">
        <Layout t-if="statistics.loadStatisticsMemoized.data" display="{controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers"> Customers </button>
                <button class="btn btn-primary" t-on-click="openLeads"> Leads </button>
            </t>
            <DashboardItem size="1.2">
                <t t-esc="'Average amount of t-shirt by order this month'" />
                <h1 t-esc="statistics.loadStatisticsMemoized.data.average_quantity" style="color:green; text-align: center;"/>
            </DashboardItem>
            <DashboardItem size="1.5">
                <t t-esc="'Average time for an order to go from new to sent or cancelled'" />
                <h1 t-esc="statistics.loadStatisticsMemoized.data.average_time" style="color:green; text-align: center;"/>
            </DashboardItem>
            <DashboardItem size="1">
                <t t-esc="'Number of new orders this month'" />
                <h1 t-esc="statistics.loadStatisticsMemoized.data.nb_new_orders" style="color:green; text-align: center;"/>
            </DashboardItem>            
            <DashboardItem size="1">
                <t t-esc="'Number of cancelled orders this month'" />
                <h1 t-esc="statistics.loadStatisticsMemoized.data.nb_cancelled_orders" style="color:green; text-align: center;"/>
            </DashboardItem>
            <DashboardItem size="1">
                <t t-esc="'The amount of new orders this month'" />
                <h1 t-esc="statistics.loadStatisticsMemoized.data.total_amount" style="color:green; text-align: center;"/>
            </DashboardItem>
            <DashboardItem size="1.4">
                <t t-esc="'Number of cancelled orders this month'" />
                <PieChart data="statistics.loadStatisticsMemoized.data.orders_by_size" />
            </DashboardItem>
        </Layout>
    </t>

</templates>
