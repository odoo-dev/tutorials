<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <t t-set="stats" t-value="this.reporting.statistics"/>
        <Layout className="'o_dashboard h-100'" display="{controlPanel: {buttons: true} }">
        <t t-set-slot="control-panel-buttons">
            <button class="btn btn-primary" t-on-click="this.openCustomersView">Customers</button>
            <button class="btn btn-primary" t-on-click="this.openLeads">Leads</button>
        </t>
        <!--
        <div t-if="stats()">
            <DashboardItem size="2.5">
                <PieChart label="'T-Shirts by size'" data="stats().orders_by_size"/>
            </DashboardItem>
        </div>
        -->
        <div class="d-flex flex-wrap" t-if="stats()">
            <t t-foreach="this.items" t-as="item" t-key="item.id">
                <DashboardItem size="item.size || 1">
                    <t t-set="itemProp" t-value="item.props ? item.props(stats()) : {'data': stats()}"/>
                    <t t-component="item.Component" t-props="itemProp"/>
                </DashboardItem>
            </t>
        </div>
        </Layout>
    </t>
</templates>