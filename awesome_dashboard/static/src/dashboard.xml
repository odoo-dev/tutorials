<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="{controlPanel: {buttons: true} }">
        <t t-set-slot="control-panel-buttons">
            <button class="btn btn-primary" t-on-click="this.openCustomersView">Customers</button>
            <button class="btn btn-primary" t-on-click="this.openLeads">Leads</button>
        </t>
        <div class="d-flex flex-wrap">
            <DashboardItem>
                Average quantity
                <div>
                <!--div class="fs-1 fw-bold text-success text-center"-->
                    <t t-out="this.statistics().average_quantity"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Average time
                <div>
                    <t t-out="this.statistics().average_time"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Number of new orders
                <div>
                    <t t-out="this.statistics().nb_new_orders"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Number of cancelled orders
                <div>
                    <t t-out="this.statistics().nb_cancelled_orders"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Total amount
                <div>
                    <t t-out="this.statistics().total_amount"/>
                </div>
            </DashboardItem>
        </div>
        <div class="d-flex flex-wrap">
            <DashboardItem>
                Orders for size 's'
                <div>
                    <t t-out="this.statistics().orders_by_size.s"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Orders for size 'm'
                <div>
                    <t t-out="this.statistics().orders_by_size.m"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Orders for size 'xl'
                <div>
                    <t t-out="this.statistics().orders_by_size.xl"/>
                </div>
            </DashboardItem>
        </div>
        </Layout>
    </t>
</templates>