<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <div class="p-3 d-flex gap-2">
                <button class="btn btn-primary" t-on-click="openCustomers">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
            </div>
            <div class="px-3 pb-3 d-flex flex-wrap gap-3">
                <DashboardItem t-foreach="statistics" t-as="stat" t-key="stat.label">
                    <h5 class="card-title" t-esc="stat.label"/>
                    <p class="card-text fs-2 fw-bold mb-0" t-esc="stat.value"/>
                </DashboardItem>
                <DashboardItem size="2">
                    <h5 class="card-title">T-shirts sold by size</h5>
                    <PieChart data="ordersBySize"/>
                </DashboardItem>
            </div>
        </Layout>
    </t>

</templates>
