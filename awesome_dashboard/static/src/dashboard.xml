<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{controlPanel: {} }" className="'o_dashboard h-100'" >
            <t t-set-slot="control-panel-buttons">
                <button class="btn btn-primary" t-on-click="this.openCustomerView">Customers</button>
                <button class="btn btn-primary" t-on-click="this.openLeads">Leads</button>
            </t>
            <div class="o_dashboard_grid">
                <DashboardItem size="1">
                    <div class="text-center">
                        <h6 class="text-muted mb-2">New orders</h6>
                        <h1 class="m-0"><t t-esc="this.stats().nb_new_orders"/></h1>
                        <small class="text-muted">This month</small>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <div class="text-center">
                        <h6 class="text-muted mb-2">Total amount</h6>
                        <h1 class="m-0"><t t-esc="this.stats().total_amount"/></h1>
                        <small class="text-muted">From new orders this month</small>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="text-center">
                        <h6 class="text-muted mb-2">Average t-shirts</h6>
                        <h1 class="m-0"><t t-esc="this.stats().average_quantity"/></h1>
                        <small class="text-muted">Per order this month</small>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="text-center">
                        <h6 class="text-muted mb-2">Cancelled orders</h6>
                        <h1 class="m-0"><t t-esc="this.stats().nb_cancelled_orders"/></h1>
                        <small class="text-muted">This month</small>
                    </div>
                </DashboardItem>
                <DashboardItem size="1">
                    <div class="text-center">
                        <h6 class="text-muted mb-2">Average processing time</h6>
                        <h1 class="m-0"><t t-esc="this.stats().average_time"/></h1>
                        <small class="text-muted">From new to sent or cancelled</small>
                    </div>
                </DashboardItem>
            </div>
        </Layout>
    </t>

    <t t-name="awesome_dashboard.DashboardItem">
        <div class="card" t-attf-style="grid-column: span {{this.props.size}};">
            <div class="card-body d-flex align-items-center justify-content-center">
                <t t-call-slot="default"/>
            </div>
        </div>
    </t>

</templates>
