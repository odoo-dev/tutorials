<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <t t-set="stats" t-value="this.reporting.statistics"/>
        <Layout className="'o_dashboard h-100'" display="{controlPanel: {buttons: true} }">
        <t t-set-slot="control-panel-buttons">
            <button class="btn btn-primary" t-on-click="this.openCustomersView">Customers</button>
            <button class="btn btn-primary" t-on-click="this.openLeads">Leads</button>
        </t>
        <div>
            <DashboardItem size="2.5">
                <PieChart label="'T-Shirts by size'" data="stats().orders_by_size"/>
            </DashboardItem>
        </div>
        <div class="d-flex flex-wrap">
            <DashboardItem>
                Average quantity
                <div>
                <!--div class="fs-1 fw-bold text-success text-center"-->
                    <t t-out="stats().average_quantity"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Average time
                <div>
                    <t t-out="stats().average_time"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Number of new orders
                <div>
                    <t t-out="stats().nb_new_orders"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Number of cancelled orders
                <div>
                    <t t-out="stats().nb_cancelled_orders"/>
                </div>
            </DashboardItem>
            <DashboardItem>
                Total amount
                <div>
                    <t t-out="stats().total_amount"/>
                </div>
            </DashboardItem>
        </div>
        </Layout>
    </t>
</templates>