<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <t t-set="statistics" t-value="this.reporting.statistics"/>
        <Layout display="{controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-buttons">
                <button class="btn btn-primary" t-on-click="this.openCustomerView">Customers</button>
                <button class="btn btn-primary" t-on-click="this.openLeads">Leads</button>
            </t>
            <div class="d-flex flex-wrap">
                <DashboardItem>
                    Average number of t-shirts by order
                    <div class="fs-1 fw-bold text-success text-center">
                        <t t-out="statistics().average_quantity"/>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    Average time (in hours) elapsed between the moment an order is created, and the moment is it sent
                    <div class="fs-1 fw-bold text-success text-center">
                        <t t-out="statistics().average_time"/>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    Number of cancelled orders, this month
                    <div class="fs-1 fw-bold text-success text-center">
                        <t t-out="statistics().nb_cancelled_orders"/>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    Number of new orders, this month
                    <div class="fs-1 fw-bold text-success text-center">
                        <t t-out="statistics().nb_new_orders"/>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    Total amount of orders, this month
                    <div class="fs-1 fw-bold text-success text-center">
                        <t t-out="statistics().total_amount"/>
                    </div>
                </DashboardItem>
            </div>
        </Layout>
    </t>
</templates>
