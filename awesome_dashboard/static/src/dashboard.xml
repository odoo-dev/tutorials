<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{controlPanel: {}}" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-buttons">
                <button class="btn btn-primary" t-on-click="this.openCustomerView">Customers</button>
                <button class="btn btn-primary" t-on-click="this.openLeads">Leads</button>
            </t>
            hello dashboard
            <div class="d-flex flex-wrap">
                <t t-foreach="Object.entries(this.reporting.stats())" t-as="stat" t-key="stat[0]">
                    <DashboardItem t-if="typeof stat[1] === 'number'">
                        <t t-out="this.reporting.stats_label[stat[0]] || stat[0]"/>
                        <div class="fs-1 fw-bold text-success text-center">
                            <t t-out="stat[1]"/>
                        </div>
                    </DashboardItem>
                    <DashboardItem t-elif="typeof stat[1] === 'object'" size="2">
                        <div>
                            <t t-out="this.reporting.stats_label[stat[0]] || stat[0]"/>
                            <PieChart data="stat[1]" label="stat[0]"/>
                        </div>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

</templates>
