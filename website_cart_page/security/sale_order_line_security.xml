<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Allow Portal Users access to their own order lines in draft/sent -->
    <record id="sale_order_line_rule_portal" model="ir.rule">
        <field name="name">Sale Order Line: Portal Users</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="sale_order_line_rule_public" model="ir.rule">
        <field name="name">Sale Order Line: Public Users</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.state', 'in', ['draft', 'sent'])]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <!-- <record id="sale_order_line_rule_portal" model="ir.rule">
