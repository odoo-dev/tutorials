<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_event_type_form_inherit">
        <field name="name">event.type.form.inherit</field>
        <field name="model">event.type</field>
        <field name="inherit_id" ref="event.view_event_type_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_questions']" position="after">
                <page string="Fields" name="field_questions">
                    <field name="field_question_id"/>
                </page>
            </xpath>
            <xpath expr="//page[@name='page_questions']" position="after">
                <page string="Partner Question" name="partner_questions">
                    <field name="partner_question_ids" />
                </page>
            </xpath>
            
        </field>
    </record>
</odoo>
