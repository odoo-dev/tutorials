<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="partner_question_action" model="ir.actions.act_window">
        <field name="name">Partner Question</field>
        <field name="res_model">partner.question</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="partner_question_view_list" model="ir.ui.view">
        <field name="name">partner.question.view.list</field>
        <field name="model">partner.question</field>
        <field name="priority" eval="10" />
        <field name="arch" type="xml">
            <list>
                <field name="title" />
            </list>
        </field>
    </record>
    <record id="partner_question_view_form" model="ir.ui.view">
        <field name="name">partner.question.view.form</field>
        <field name="model">partner.question</field>
        <field name="priority" eval="10" />
        <field name="arch" type="xml">
            <form string="Create Partner Question">
                <sheet>
                    <group>
                        <field name="title" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>