<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.todoitem">
        <t t-set="item" t-value="props.todo"/>
        <div class="d-inline-flex align-items-center"
             t-att-class="{'text-muted text-decoration-line-through': item.isCompleted}">
            <input type="checkbox"
                   t-on-change="callToggleStateOnParent">
                <t t-value="item.isCompleted"/>
            </input>
            <span class="px-2">
                <t t-out="item.id"/>. <t t-out="item.description"/>
            </span>
            <span class="fa fa-remove text-end link-danger" t-on-click="callDeleteTodoOnParent"/>
        </div>
    </t>

    <t t-name="awesome_owl.todolist">
        <div class="card d-inline-flex m-2">
            <div class="card-body">
                <div class="input-group pb-2">
                    <input type="text"
                           class="form-control"
                           t-on-keyup="ev => this.addTodo(ev, ev.target.value)"
                           placeholder="Add a todo"
                           t-ref="todo_desc"
                    />
                </div>

                <t t-foreach="todos" t-as="todo" t-key="todo.id">
                    <div>
                        <TodoItem todo="todo"
                                  toggle.bind="toggleState"
                                  remove.bind="removeTodo"
                        />
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>