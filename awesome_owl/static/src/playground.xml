<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="owl.playground">
    <div>
      <t t-foreach="state.counters" t-as="counter" t-key="counter.id">
        <Counter
          counter="counter"
          onIncrement.alike="() => onIncrement(counter.id)"
        />
      </t>
    </div>
    <Card title="'Counters Sum'" content="state.sum" />
    <div class="p-4 border">
      <TodoList />
    </div>
  </t>
</templates>
