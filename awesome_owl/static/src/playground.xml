<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div>
            <div class="counters card d-inline-block p-2 m-2" style="border: 2px solid">
                <h4 class="text-decoration-underline">Counters</h4>
                <div style="display: flex; gap: 10px;">
                    <Counter onChange.bind="incrementSum"/>
                    <Counter onChange.bind="incrementSum"/>
                </div>
                <p >The sum is: <t t-esc="state.sum" /> </p>
            </div>
        </div>
        <div>
        <div class="cards p-2 m-2" style="border: 2px solid">
            <h4 class="text-decoration-underline">Cards</h4>
            <Card title="'card 1'"><t t-set-slot="content"><Counter /></t></Card>
            <Card title="'card 2'"></Card>
        </div>
        </div>
        <div>
        <div class="todolist card p-2 m-2" style="width: 20rem; border: 2px solid">
            <h4 class="text-decoration-underline">Todo List</h4>
            <TodoList />
        </div>
        </div>
    </t>

</templates>