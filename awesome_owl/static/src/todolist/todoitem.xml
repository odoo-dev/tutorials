<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    
    <t t-name="awesome_owl.todoitem">
        <div t-att-class="{'text-muted text-decoration-line-through': props.isCompleted}">
            <input t-model="state.checkboxState" type="checkbox" t-on-click="onCheckboxStateChange" />
            <t t-esc="props.id + '. '"/>
            <t t-esc="props.description"/>
            <span class="fa fa-remove" t-on-click="onDeleteClick" />
        </div>
    </t>

</templates>
