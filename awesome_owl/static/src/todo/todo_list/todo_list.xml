<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="todo.list.playground">
    <div class="container">
      <form t-on-submit.prevent="this.onAddTodo" id="todo-form">
        <!-- <input t-ref="description_ref" type="text" name="description" /> -->
        <div class="form-group d-flex gap-2">
          <input
            t-ref="description_ref"
            type="text"
            name="description"
            placeholder="Walk with the dog"
          />
          <input type="submit" value="Add" />
        </div>
      </form>
      <ul>
        <t t-foreach="state.todos" t-as="todo" t-key="todo.id">
          <TodoItem
            todo="todo"
            onComplete.alike="() => onCompleteTodo(todo.id)"
            onDelete.alike="() => onRemoveTodo(todo.id)"
          />
        </t>
      </ul>
    </div>
  </t>
</templates>
