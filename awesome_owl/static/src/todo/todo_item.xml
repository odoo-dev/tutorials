<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoItem">
        <div>
            <input 
                type="checkbox"
                t-att-checked="props.todo.isCompleted" 
                class="form-check-input me-2" 
                t-on-change="() => props.toggleState(props.todo.id)"
            />
            <span t-att-class="{'text-decoration-line-through text-muted': props.todo.isCompleted}">
                <t t-esc="props.todo.id"/>. <t t-esc="props.todo.description"/>
            </span>
            <span 
                class="fa fa-remove"
                t-on-click="() => props.removeItem(props.todo.id)"
            />
        </div>
    </t>

</templates>