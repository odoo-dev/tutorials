<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_list">
        <div class="p-2 border">
            <div>
                <p>Todo List</p>
            </div>
            <div class="mb-2">
                <input placeholder="Enter a new task" t-on-keyup="ev => this.addTodo(ev)" t-ref="input_todo"/>
            </div>
            <div class="border p-1">
                <t t-foreach="todos" t-as="todo" t-key="todo.id">
                    <TodoItem todo="todo" toggleState.bind="toggleState" removeTodo.bind="removeTodo"/>
                </t>
            </div>
        </div>
    </t>

    <t t-name="awesome_owl.todo_item">
        <div class="d-flex align-items-center">
            <div class="p-1 gap-2">
                <span class="fa fa-trash" t-on-click="() => props.removeTodo(props.todo.id)"/>
            </div>
            <div class="d-flex align-items-center p-1 gap-2 " t-att-class="props.todo.isCompleted and 'text-muted text-decoration-line-through'">
                <input type="checkbox" t-on-change="() => props.toggleState(props.todo.id)"/>
                <t t-out="props.todo.id"/>.
                <t t-out="props.todo.description"/>
            </div>
        </div>
    </t>

</templates>
