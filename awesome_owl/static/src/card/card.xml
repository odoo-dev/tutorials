<t t-name="awesome_owl.card">
    <div class="card d-inline-block m-2" style="width: 18rem;">
        <div class="card-header">
            <h5 class="card-title">
                <t t-esc="props.title" />
            </h5>
            <button t-on-click="collpaseCard">toggle</button>
        </div>
        <div class="card-body">
            <p class="card-text" t-if="state.isCollapsed">
                <t t-slot="default" />
            </p>
        </div>
    </div>
</t>