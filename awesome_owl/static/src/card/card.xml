<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.card">
        <div class="card d-inline-block" style="width: 18rem;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title"><t t-out="props.title" /></h5>
                    <button class="btn btn-primary" t-if="!open.value" t-on-click="toggle">v</button>
                    <button class="btn btn-primary" t-if="open.value" t-on-click="toggle">x</button>
                </div>
                <p class="card-text" t-if="open.value">
                    <t t-slot="default"/>
                </p>
            </div>
        </div>
    </t>

</templates>
