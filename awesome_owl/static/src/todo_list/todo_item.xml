<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.todo_item">
        <div t-att-class="{'text-decoration-line-through text-muted': props.todo.isCompleted}">
            <input type="checkbox" t-on-change="onToggle" name="test"
                value="test" t-att-checked="props.todo.isCompleted" />
            <t t-esc="props.todo.id" />.
            <t t-esc="props.todo.description" />
        </div>
    </t>
</templates>