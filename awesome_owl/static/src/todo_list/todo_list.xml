<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_list">
        <input type="text" t-on-keyup="addTodo" t-ref="input_field"/>
        <div>
            <p t-foreach="todos" t-as="i" t-key="i.id">
                <TodoItem todo="i" toggleState.bind="toggleState" />
            </p>
        </div>
    </t>
</templates>