<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_schedule_plan_project_wizard" model="ir.actions.act_window">
        <field name="name">Add Student</field>
        <field name="res_model">schedule.plan.project.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
    <record id="view_schedule_plan_project_wizard_form" model="ir.ui.view">
        <field name="name">Add Student</field>
        <field name="model">schedule.plan.project.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Student in Semester">
                <group>
                    <field name="project_id"/>
                </group>
                <footer>
                    <button string="Add" name="add_student" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
