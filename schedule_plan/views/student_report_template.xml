<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="student_report_template" name="Student Report">
        <t t-call="website.layout">
            <div class="container my-4">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <img itemprop="image" class="o_portal_contact_img rounded o_object_fit_cover" style="width: 320px; height: 400px; object-fit: cover;" t-att-src="image_data_uri(user['image'])" alt="User Photo"/>
                    </div>
                    <div class="col-md-5">
                        <div class="mb-2 d-flex">
                            <span class="fw-bold me-2" style="min-width: 80px;">Name:</span>
                            <span>
                                <t t-out="user['name'] or '-'"/>
                            </span>
                        </div>
                        <div class="mb-2 d-flex">
                            <span class="fw-bold me-2" style="min-width: 80px;">Project:</span>
                            <span>
                                <t t-out="user['project'] or '-'"/>
                            </span>
                        </div>
                        <div class="mb-2 d-flex">
                            <span class="fw-bold me-2" style="min-width: 80px;">Duration:</span>
                            <span>
                                <t t-out="user['duration'] or '-'"/>
                            </span>
                        </div>
                        <div class="mb-2 d-flex">
                            <span class="fw-bold me-2" style="min-width: 80px;">Phone:</span>
                            <span>
                                <t t-if="user['phone']">
                                    <a t-att-href="'tel:' + user['phone']">
                                        <t t-out="user['phone']"/>
                                    </a>
                                </t>
                                <t t-if="not user['phone']">-</t>
                            </span>
                        </div>
                        <div class="mb-2 d-flex">
                            <span class="fw-bold me-2" style="min-width: 80px;">Email:</span>
                            <span>
                                <t t-if="user['email']">
                                    <a t-att-href="'mailto:' + user['email']">
                                        <t t-out="user['email']"/>
                                    </a>
                                </t>
                                <t t-if="not user['email']">-</t>
                            </span>
                        </div>
                        <div class="mb-2 d-flex">
                            <span class="fw-bold me-2" style="min-width: 80px;">Address:</span>
                            <span>
                                <t t-out="user['address'] or '-'"/>
                            </span>
                        </div>
                        <div class="mb-2">
                            <span class="fw-bold me-2" style="min-width: 80px;">Attendance:</span>
                            <div class="progress w-100 fs-4" style="height: 35px;">
                                <t t-if="user['attendance'] &lt; 30">
                                    <div class="progress-bar bg-danger" role="progressbar" t-att-style="'width: {}%;'.format(user['attendance'] if user['attendance'] > 0 else 100)" t-att-aria-valuenow="user['attendance']" aria-valuemin="0" aria-valuemax="100">
                                        <t t-out="user['attendance']"/>
%
                                    </div>
                                </t>
                                <t t-elif="user['attendance'] &lt; 75">
                                    <div class="progress-bar bg-warning" role="progressbar" t-att-style="'width: {}%;'.format(user['attendance'])" t-att-aria-valuenow="user['attendance']" aria-valuemin="0" aria-valuemax="100">
                                        <t t-out="user['attendance']"/>
%
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="progress-bar bg-success" role="progressbar" t-att-style="'width: {}%;'.format(user['attendance'])" t-att-aria-valuenow="user['attendance']" aria-valuemin="0" aria-valuemax="100">
                                        <t t-out="user['attendance']"/>
%
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div id="student_report_chart" style="width: 400px; height: 400px; margin: auto;" t-att-data-attendance="json.dumps(user['data'])">
                            <canvas id="userChart" width="200" height="200"></canvas>
                        </div>
                    </div>
                </div>
                <div class="my-4 o_wevent_index_topbar_filters d-flex d-print-none align-items-center justify-content-end flex-wrap gap-2 w-100">
                    <div class="dropdown d-none d-lg-block">
                        <a href="/my/attendance/report?filter=attended" role="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown" title="Filter by Attendance">
                            <t t-esc="filterBy.replace('_', ' ').title()" />
                        </a>
                        <div class="dropdown-menu">
                            <a t-attf-class="dropdown-item #{'active' if filterBy == 'all' else ''}" href="/my/attendance/report">
                                All
                            </a>
                            <a t-attf-class="dropdown-item #{'active' if filterBy == 'attended' else ''}" href="/my/attendance/report?filter=attended">
                                Attended
                            </a>
                            <a t-attf-class="dropdown-item #{'active' if filterBy == 'not_attended' else ''}" href="/my/attendance/report?filter=not_attended">
                                Not Attended
                            </a>
                        </div>
                    </div>

                    <table class="table table-borderless">
                        <thead style="display: table-row-group; border-bottom: 1px solid black;">
                            <tr>
                                <th class="text-start fw-bold" style="width: 20%" scope="col">Lecture</th>
                                <th class="text-start fw-bold" style="width: 20%" scope="col">Lecturer</th>
                                <th class="text-start fw-bold" style="width: 20%" scope="col">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lecture_details" t-as="lecture" t-key="lecture_index">
                                <tr style="border-bottom: 1px solid lightgrey;">
                                    <td class="align-top">
                                        <t t-if="lecture['isAttended']">
                                            <span class="bg-success rounded-circle d-inline-block me-2" style="width:10px; height:10px;"></span>
                                        </t>
                                        <t t-else="">
                                            <span class="bg-danger rounded-circle d-inline-block me-2" style="width:10px; height:10px;"></span>
                                        </t>
                                        <span t-out="lecture['name']"></span>
                                    </td>
                                    <td class="align-top">
                                        <span t-out="lecture['lecturer']"/>
                                    </td>
                                    <td class="align-top text-break">
                                        <span t-out="lecture['start']"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
