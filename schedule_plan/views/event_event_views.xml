<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event.action_event_view" model="ir.actions.act_window">
        <field name="view_id" ref="event.view_event_calendar"/>
    </record>
    <record id="view_event_form_inherit_schedule_plan" model="ir.ui.view">
        <field name="name">view.event.form.inherit.schedule.plan</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="project_id" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_event_calendar_inherit_schedule_plan" model="ir.ui.view">
        <field name="name">view.event.calendar.inherit.schedule.plan</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="project_id" string=""/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">not user_id</attribute>
            </xpath>
            <xpath expr="//field[@name='seats_taken']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='seats_reserved']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='seats_used']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
