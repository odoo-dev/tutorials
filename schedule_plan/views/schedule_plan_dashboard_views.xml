<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="schedule_plan_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">schedule.dashboard</field>
        <field name="path">schedule-dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="domain">[('project_id', '=', active_id)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events found. Let's create one!
            </p>
            <p>
                Keep track of upcoming events and share important details with attendees.
            </p>
        </field>
    </record>

    <record id="schedule_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">schedule.dashboard.view.kanban</field>
        <field name="model">schedule.dashboard</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" sample="1">
                <field name="color"/>
                <templates>
                    <t t-name="card" class="card w-100">
                        <div class="o_kanban_card_content d-flex flex-wrap justify-content-evenly align-items-center gap-2 p-2">
                            <div class="o_kanban_section d-flex align-items-center flex-grow-1">
                                <field name="user_id" widget="many2one_avatar_user" class="me-2"/>
                                <field name="user_id"/>
                            </div>
                            <button type="object" name="subject_list_view_action" class="o_kanban_section text-center flex-grow-1">
                                <field name="subject_count" class="fw-bolder"/>
                                <div>Subjects</div>
                            </button>
                            <button type="object" name="event_list_view_action" class="o_kanban_section text-center flex-grow-1">
                                <b>
                                    <field name="completed_events"/>/
                                    <field name="total_events"/> Events
                                    <span invisible="not total_events">
                                    (<field name="completion_percentage"/>%)
                                    </span>
                                </b>
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
