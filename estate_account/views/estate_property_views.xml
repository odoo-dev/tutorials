<?xml version="1.0"?>
<odoo>
    <record id="estate_property_view_form_inherit_estate_account" model="ir.ui.view">
        <field name="name">estate.property.form.inherit.estate_account</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/*" position="before">
                <div class="oe_button_box" name="button_box">
                    <button type="object" name="action_view_invoices"
                        invisible="account_move_count &lt; 1"
                        class="oe_stat_button" icon="fa-money">
                        <field name="account_move_count" widget="statinfo" string="Invoices" />
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
