<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_line_list_flask_button" model="ir.ui.view">
        <field name="name">sale.order.line.list.flask.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_template_id']" position="after">
                <button name="action_open_flask_wizard"
                    type="object"
                    icon="fa-flask"/>
            </xpath>
        </field>
    </record>
</odoo>
