<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_purchase_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
        <xpath expr="//field[@name='module_purchase_product_matrix']" position="after">
            <div invisible="not module_purchase_product_matrix">
                <field name="purchase_product_variant_mode" class="o_light_label" widget="radio"/>
            </div>
        </xpath>
        </field>
    </record>
</odoo>
