<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="form_view" model="ir.ui.view">
        <field name="name">automated.auction.view.form.inherit.estate</field>
        <field name="model">estate.property</field>
        <field name="priority" eval="20" />
        <field name="inherit_id" ref="estate.form_view" />
        <field name="arch" type="xml">
          <xpath expr="//sheet" position="inside">
               <div class="oe_button_box" name="button_box">
                    <button name="action_invoice" type="object" class="oe_stat_button" invisible="state not in ['auction']">
                        <div class="o_stat_info">
                            <span class="o_stat_value" style="font-size: 14px;">
                                <span class="fa fa-file-text me-1" style="font-size: 18px;"></span>
                                Invoice
                            </span>
                        </div>
                    </button>
                </div>
            </xpath>

            <xpath expr="//group[@name='main_group']" position="replace">
               <group name="main_group">
                        <group>
                            <h1>
                                <field name="name" />
                            </h1>
                            <field name="state" widget="radio" options="{'horizontal': True}" class="o_form_label"/>
                            <field name="tags_ids" widget="many2many_tags"
                                options="{'color_field': 'color'}" />
                        </group>
                        <group>
                            <group>
                                <field name="auction_started" widget="auction_status_selection_kanban" nolabel="1"
                                    invisible="state not in ['auction']" newline="1"/>
                            </group>
                        <field name="image_1920" nolabel="1" widget='image' optional="show "
                            class="oe_avatar mt-2" style="max-width: 150px; max-height: 150px;"/>
                        </group>
                </group>
            </xpath>

            <xpath expr="//button[@name='action_sold']" position="before">
                <button name="action_auction" string="Start Auction" type="object"
                    class="btn-secondary" invisible="state not in ['auction'] or auction_started in ['auction','sold']" />
            </xpath>

            <xpath expr="//notebook/page[@name='description']/group" position="after">
                <group name="auction_details" string="Auction details" invisible="state not in ['auction']">
                    <field name="end_time" />
                    <field name="highest_offer" />
                    <field name="highest_bidder" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">automated.auction.view.kanban.inherit.estate</field>
        <field name="model">estate.property</field>
        <field name="priority" eval="20" />
        <field name="inherit_id" ref="estate.estate_property_view_kanban" />
        <field name="arch" type="xml">
        <xpath expr="//field[@name='tags_ids']" position="after">
            <field name="auction_started" widget="auction_status_selection_form" nolabel="1"/>
        </xpath>
        </field>
    </record>
</odoo>
