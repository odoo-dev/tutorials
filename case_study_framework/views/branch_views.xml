<?xml version="1.0"?>
<odoo>
    <record id="action_branch_view" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_branch_list" model="ir.ui.view">
        <field name="name">sale.branch.list</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>
</odoo>