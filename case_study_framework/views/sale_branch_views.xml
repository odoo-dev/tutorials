<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="sale_branch_action" model="ir.actions.act_window">
        <field name="name">Sales Branch</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="sale_branch_form_view" model="ir.ui.view">
        <field name="name">sale_branch_form</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <form string="Sale Branch">
                <group>
                    <field name="name"/>
                    <field name="sequence_id"/>
                    <field name="code"/>
                </group>
            </form>
        </field>
    </record>

    <record id="sale_branch_list_view" model="ir.ui.view">
        <field name="name">sale_branch_tree</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <list string="Sale Branches">
                <field name="name"/>
                <field name="sequence_id"/>
                <field name="code"/>
            </list>
        </field>
    </record>
</odoo>