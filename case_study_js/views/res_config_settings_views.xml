<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.case_study_js</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting help="Add a custom congratulatory message to receipt">
                    <field name="pos_is_congratulatory_message" />
                    <div class="content-group mt16" invisible="not pos_is_congratulatory_message">
                        <div>
                            <label string="Message" for="pos_congratulatory_message" class="col-lg-2 o_light_label mb-2 me-3" />
                            <field name="pos_congratulatory_message" placeholder="e.g. Thank you for your purchase!" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>