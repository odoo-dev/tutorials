<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="case_study_js.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//OrderlineNoteButton" position="after">
            <button
                t-attf-class="{{this.buttonClass}} flex-shrink-0"
                t-att-disabled="!pos.get_order()?.get_selected_orderline()" 
                t-on-click="() => pos.get_order()?.get_selected_orderline()?.delete()">
                    <i class="fa fa-trash me-1"/><span>Clear</span>
            </button>
        </xpath>
    </t>
</templates>