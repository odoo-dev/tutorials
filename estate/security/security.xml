<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_estate">
        <field name="name">Real Estate</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage"/>
        <field name="sequence">7</field>
    </record>

    <record id="group_estate_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
    </record>

    <record id="group_estate_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="implied_ids" eval="[Command.link(ref('group_estate_user'))]"/>
    </record>

    <record id="rule_limited_read_estate_agent" model="ir.rule">
        <field name="name">Limit estate agents to their own properties.</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('group_estate_user'))]"/>
        <field name="domain_force">
            ['|', ('user_id', '=', user.id), ('user_id', '=', False)]
        </field>
    </record>

    <record id="rule_limited_read_estate_manager" model="ir.rule">
        <field name="name">Limit estate agents to their own properties.</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('group_estate_manager'))]"/>
    </record>

    <record id="rule_limited_read_company" model="ir.rule">
        <field name="name">Limit estate agents to properties of their companies.</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', '=', company_id)]
        </field>
    </record>
</odoo>
