<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_users_property_offers">
        <t t-foreach="docs" t-as="user">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">

                        <h1>
                            <strong>Salesman: </strong>
                            <span t-field="user.name" />
                        </h1>

                        <t t-foreach="user.property_ids" t-as="docs">
                            <t t-call="estate.report_property_offers_content" />
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>