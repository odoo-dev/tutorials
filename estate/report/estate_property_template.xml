<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <template id="estate_property_offers_table_template">
        <table t-if="len(property.offer_ids) > 0" class="table">
            <t t-set="offers" t-value="property.mapped('offer_ids')" />
            <thead>
                <tr>
                    <th>Price</th>
                    <th>Partner</th>
                    <th>Validity (days)</th>
                    <th>Deadline</th>
                    <th>State</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="offers" t-as="offer">
                    <td>
                        <span t-field="offer.price" />
                    </td>
                    <td>
                        <span t-field="offer.partner_id.name" />
                    </td>
                    <td>
                        <span t-field="offer.validity" />
                    </td>
                    <td>
                        <span t-field="offer.date_deadline" />
                    </td>
                    <td>
                        <span t-field="offer.status" />
                    </td>
                </tr>
            </tbody>
        </table>
        <div t-else="">
            <p>
                <b>No offers have been made yet</b>
            </p>
        </div>
    </template>

    <template id="estate_property_report_template">
        <t t-foreach="docs" t-as="property">
            <!-- <t t-call="web.html_container"> -->
                <t t-call="web.external_layout" />
                    <main>
                        <div class="page">
                            <h2>
                                <span t-field="property.name" />
                            </h2>
                            <div class="estate_property_info">
                                <strong>Salesman: </strong>
                                <span t-field="property.salesperson_id.name" />
                                <br />
                                <strong>Expected Price: </strong>
                                <span t-field="property.expected_price" />
                                <br />
                                <strong>Status: </strong>
                                <span t-field="property.state" />
                                <br />
                            </div>
                            <hr />
                            <t t-call="estate.estate_property_offers_table_template" />
                        </div>
                    </main>
                <!-- </t> -->
            <!-- </t> -->
        </t>
    </template>
</odoo>