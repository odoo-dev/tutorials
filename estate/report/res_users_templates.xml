<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_res_users">
        <t t-foreach="docs" t-as="user">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <strong>Salesman:</strong>
                            <span t-field="user.name"/>
                        </h2>

                        <h3 class="mt32">Properties</h3>
                        <t t-foreach="user.property_ids" t-as="property">
                            <div class="mb32">
                                <h4>
                                    <span t-field="property.name"/>
                                </h4>
                                <div class="mb16">
                                    <div>
                                        <strong>Expected Price:</strong>
                                        <span t-field="property.expected_price"/>
                                    </div>
                                    <div>
                                        <strong>Status:</strong>
                                        <span t-field="property.state"/>
                                    </div>
                                </div>

                                <t t-call="estate.report_estate_property_offers_table" t-if="property.offer_ids"/>
                                <p t-else="">No offers available for this property.</p>
                            </div>
                        </t>
                        <p t-if="not user.property_ids">No properties found for this salesman.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>