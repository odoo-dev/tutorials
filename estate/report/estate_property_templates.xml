<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_estate_property">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="property.name"/>
                        </h2>
                        <div class="mb16">
                            <div>
                                <strong>Salesman:</strong>
                                <span t-field="property.user_id.name"/>
                            </div>
                            <div>
                                <strong>Expected Price:</strong>
                                <span t-field="property.expected_price"/>
                            </div>
                            <div>
                                <strong>Status:</strong>
                                <span t-field="property.state"/>
                            </div>
                        </div>
                        <t t-call="estate.report_estate_property_offers_table" t-if="property.offer_ids"/>
                        <p t-else="">No offers available.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_estate_property_offers_table">
        <table class="table table-borderless">
            <thead>
                <tr>
                    <th>Price</th>
                    <th>Partner</th>
                    <th>Validity (days)</th>
                    <th>Deadline</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="property.offer_ids" t-as="offer">
                    <tr>
                        <td>
                            <span t-field="offer.price"/>
                        </td>
                        <td>
                            <span t-field="offer.partner_id.name"/>
                        </td>
                        <td>
                            <span t-field="offer.validity"/>
                        </td>
                        <td>
                            <span t-field="offer.date_deadline"/>
                        </td>
                        <td>
                            <span t-field="offer.status"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
</odoo>