<odoo noupdate="1">
    <record id="big_villa" model="estate_property">
      <field name="name">Big Villa</field>
      <field name="state">new</field>
      <field name="description">A nice and big villa</field>
      <field name="postcode">12345</field>
      <field name="date_availability" eval="'2020-02-02'"/>
      <field name="expected_price">1600000.0</field>
      <field name="bedrooms">6</field>
      <field name="living_area">100</field>
      <field name="facades">4</field>
      <field name="garage">True</field>
      <field name="garden">True</field>
      <field name="garden_area">100000</field>
      <field name="garden_orientation">south</field>
      <field name="property_type_id" ref="standard_residential" />
    </record>
  
    <record id="trailer_home" model="estate_property">
      <field name="name">Trailer home</field>
      <field name="state">cancelled</field>
      <field name="description">Home in a trailer park</field>
      <field name="postcode">54321</field>
      <field name="date_availability" eval="'1970-01-01'"/>
      <field name="expected_price">100000.0</field>
      <field name="selling_price">120000.0</field>
      <field name="bedrooms">1</field>
      <field name="living_area">10</field>
      <field name="facades">4</field>
      <field name="garage">False</field>
      <field name="property_type_id" ref="standard_residential" />
    </record>

    <record id="tai_ming_house" model="estate_property">
      <field name="name">Tai Ming House</field>
      <field name="state">offer_received</field>
      <field name="description">Cozy apartment in Quarry Bay</field>
      <field name="postcode">11111</field>
      <field name="date_availability" eval="'2028-08-26'"/>
      <field name="expected_price">15000.0</field>
      <field name="bedrooms">2</field>
      <field name="living_area">10</field>
      <field name="facades">1</field>
      <field name="garage">False</field>
      <field name="property_type_id" ref="standard_residential" />
      <field name="offer_ids" eval="[
        Command.create({
            'partner_id': ref('base.res_partner_2'),
            'price': 14000,
            'validity': 14,
        }),
        Command.create({
            'partner_id': ref('base.res_partner_2'),
            'price': 14500,
            'validity': 14,
        }),
        Command.create({
            'partner_id': ref('base.res_partner_2'),
            'price': 14900,
            'validity': 14,
        }),
      ]" />
    </record>
  </odoo>