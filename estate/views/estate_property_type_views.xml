<?xml version="1.0"?>
<odoo>
    <record id="estate_type_action" model="ir.actions.act_window">
        <field name="name">Property types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_type_list_view" model="ir.ui.view">
        <field name="name">Estate Type List</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" string="Title" />
                <field name="offer_count" />
                <field name="offer_ids" />
            </list>
        </field>
    </record>

    <record id="estate_type_form_view" model="ir.ui.view">
        <field name="name">Properties</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="New property type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(estate_offer_action)d" type="action"
                            class="oe_stat_button" icon="fa-money">
                            <field name="offer_count" widget="statinfo" string="Offers" />
                        </button>
                    </div>
                    <h1>
                        <field name="name" placeholder="House" />
                    </h1>
                    <notebook>
                        <page string="Properties">
                            <list>
                                <field name="property_ids">
                                    <list>
                                        <field name="name" />
                                        <field name="expected_price" />
                                        <field name="state" />
                                    </list>
                                </field>
                            </list>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>