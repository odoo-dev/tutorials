<?xml version="1.0"?>
<odoo>
    <record id="estate_default_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,search,kanban</field>
        <field name="context">{'search_default_available_estate': True}</field>
    </record>

    <record id="estate_list_view" model="ir.ui.view">
        <field name="name">Estate List</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="state=='offer_recieved' or state=='offer_accepted'"
                decoration-bf="state=='offer_accepted'" decoration-muted="state=='sold'">
                <field name="name" string="Title" />
                <field name="property_type_id" string="Type" />
                <field name="postcode" string="Postcode" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'tag_color'}" />
                <field name="bedrooms" string="Bedrooms" />
                <field name="living_area" string="Living Area (sqm)" />
                <field name="expected_price" string="Expected Price" />
                <field name="selling_price" string="Selling Price" />
                <field name="date_availability" string="Available From" optional="True" />
            </list>
        </field>
    </record>

    <record id="estate_form_view" model="ir.ui.view">
        <field name="name">Properties</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="New House">
                <header>
                    <group invisible="state == 'sold' or state == 'canceled'">
                        <button name="action_sold_property" type="object" string="Sell"
                            class="oe_highlight" />
                        <button name="action_cancel_property" type="object" string="Cancel" />
                    </group>
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,offer_recieved,offer_accepted,sold"
                        options="{'can_write': true}" />
                </header>
                <sheet>
                    <h1>
                        <field name="name" placeholder="New House" />
                    </h1>
                    <div class="mb-3">
                        <field name="tag_ids" widget="many2many_tags"
                            options="{'color_field': 'tag_color'}" />
                    </div>
                    <div class="row">
                        <div class="col">
                            <group>
                                <field name="property_type_id" string="Type"
                                    options="{'no_create': true, 'no_open': true}" />
                                <field name="postcode" string="Postcode" />
                                <field name="date_availability" string="Available From" />
                            </group>
                        </div>
                        <div class="col">
                            <group>
                                <field name="expected_price" string="Expected Price" />
                                <field name="best_price" string="Best Price" />
                                <field name="selling_price" string="Selling Price" />
                            </group>
                        </div>
                    </div>

                    <notebook>
                        <page string="Description">
                            <div class="row w-50">
                                <div class="col">
                                    <group>
                                        <field name="description" string="Description" />
                                        <field name="bedrooms" string="Bedrooms" />
                                        <field name="living_area" string="Living Area (sqm)" />
                                        <field name="garden" string="Garden" />
                                        <field name="garden_area" string="Garden Area (sqm)" />
                                        <field name="total_area" string="Total Area" />
                                        <field name="garage" string="Garage" />
                                        <field name="garden_orientation" string="Garden Orientation" />
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Offers">
                            <list>
                                <field name="offer_ids" string="Offer" />
                            </list>
                        </page>
                        <page string="Other info">
                            <div class="row w-50">
                                <div class="col">
                                    <group>
                                        <field name="salesperson_id" string="Salesman" />
                                        <field name="buyer_id" string="Buyer" />
                                    </group>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_search" model="ir.ui.view">
        <field name="name">Properties</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title" />
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" string="Living Area (sqm)"
                    filter_domain="[('living_area','>=',self)]" />
                <field name="facades" />
                <filter string="Available properties" name="available_estate"
                    domain="['|',('state','=','new'),('state','=','offer_recieved')]" />
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}" />
            </search>
        </field>
    </record>

    <record id="estate_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="0">
                <field name="state" />
                <field name="tag_ids" />
                <templates>
                    <t t-name="card">
                        <div>
                            <div>
                                <strong>
                                    <field name="name" />
                                </strong>
                            </div>
                            <div> Expected Price: <field name="expected_price" />
                            </div>
                            <div t-if="record.state.raw_value == 'offer_recieved'"> Best Offer: <field
                                    name="best_price" />
                            </div>
                            <div t-if="record.state.raw_value == 'offer_accepted'"> Selling Price: <field
                                    name="selling_price" />
                            </div>
                            <div t-if="record.tag_ids.raw_value.length &gt; 0">
                                <field name="tag_ids" widget="many2many_tags"
                                    options="{'color_field': 'tag_color'}" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>