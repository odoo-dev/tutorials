<?xml version="1.0"?>
<odoo>
    <record id="estate_action_properties" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>

    <record id="estate_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list
                string="Properties"
                decoration-success="state in ['offer_received', 'offer_accepted']"
                decoration-bf="state=='offer_accepted'"
                decoration-muted="state=='sold'"
            >
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" optional="hide" />
                <field name="property_type_id" />
            </list>
        </field>
    </record>

    <record id="estate_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <group invisible="state == 'sold' or state == 'cancelled'">
                        <button name="action_sold" string="Sold" type="object" />
                        <button name="action_cancel" string="Cancel" type="object" />
                    </group>
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,offer_received,offer_accepted,sold" />
                </header>
                <sheet>
                    <group>
                        <div>
                            <h1>
                                <field name="name" />
                            </h1>
                            <h4>
                                <field name="tag_ids" widget="many2many_tags"
                                    options="{'color_field': 'color'}" />
                            </h4>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': true}" />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="best_price" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="garage" />
                                <field name="garden" />
                                <field name="garden_area" />
                                <field name="garden_orientation" />
                                <field name="total_area" readonly="1" />
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" string="Offers">
                                <list
                                    editable="bottom"
                                    decoration-success="status == 'accepted'"
                                    decoration-danger="status == 'refused'"
                                >
                                    <field name="price" />
                                    <field name="partner_id" />
                                    <field name="validity" />
                                    <field name="date_deadline" />
                                    <button name="action_accept" type="object" icon="fa-check"
                                        title="Accept Offer" />
                                    <button name="action_refuse" type="object" icon="fa-times"
                                        title="Refuse Offer" />
                                </list>
                                <form string="Create Offer">
                                    <group>
                                        <field name="price" />
                                        <field name="partner_id" required="1" />
                                        <field name="validity" />
                                        <field name="date_deadline" />
                                        <field name="status" readonly="1" />
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id" />
                                <field name="buyer_id" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Property">
                <field name="name" />
                <field name="postcode" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" string="Living Area"
                    filter_domain="[('living_area', '>=', self)]" />
                <field name="facades" />
                <separator />
                <filter string="Available" name="available" domain="[('active', '=', True)]" />
                <group expand="1" string="Group By">
                    <filter string="Postcode" name="postcode"
                        context="{'group_by':'postcode', 'residual_visible':True}" />
                </group>
            </search>
        </field>
    </record>

    <record id="estate_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban string="Property" default_group_by="property_type_id" records_draggable="False">
                <field name="property_type_id" />
                <field name="state" />
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <h3>
                                <field name="name" />
                            </h3>
                            <div> Expected Price: <field name="expected_price" widget="monetary" options="{'field_digits': True}" />
                            </div>
                            <div t-if="record.state.raw_value == 'offer_accepted'"> Best Offer: <field name="best_price" widget="monetary" options="{'field_digits': True}" />
                            </div>
                            <div t-if="record.state.raw_value == 'sold'"> Selling Price: <field name="selling_price" widget="monetary" options="{'field_digits': True}" />
                            </div>
                            <div>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>