<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available_properties':True}</field>
    </record>

    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate_property_list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Property" decoration-bf="state == 'offer_accepted'"
                  decoration-success="state in ['offer_received', 'offer_accepted']" decoration-muted="state == 'sold'">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hidden"/>
                <field name="property_type_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate_property_form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="new,offer_received,offer_accepted,sold"/>
                        <button name="action_sold" type="object" string="Sold" class="oe_highlight"
                                invisible="state in ['sold', 'cancelled']"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ['sold', 'cancelled']"/>
                    </header>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="tag_ids" widget="many2many_tags" class="mb32" options="{'color_field': 'color'}"/>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': true}"/>
                            <field name="postcode"/>
                            <field string="Available From" name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field string="Living Area (sqm)" name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ['sold', 'cancelled', 'offer_accepted']"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="user_id"/>
                                <field name="partner_id"/>
                                <field name="company_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search" model="ir.ui.view">
        <field name="name">estate_property_search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <filter name="available_properties" string="Available"
                        domain="['|',
                        ('state', '=', 'new'),
                        ('state', '=', 'offer_received')]"/>
                <group string="Group By">
                    <filter string="Postcode" name="postcode"
                            context="{'group_by':'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_kanban_view" model="ir.ui.view">
        <field name="name">estate_property_kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_property" default_group_by="property_type_id" groups_draggable="false"
                    records_draggable="false">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="mt-2">
                                        <strong>Expected:</strong>
                                        <field name="expected_price" widget="monetary" class="ml4"/>
                                    </div>
                                    <div class="mt-2" invisible="state not in ['new', 'offer_received']">
                                        <strong>Best Offer:</strong>
                                        <field name="best_price" widget="monetary" class="ml4"/>
                                    </div>
                                    <div class="mt-2" invisible="state not in ['offer_accepted', 'sold']">
                                        <strong>Sold:</strong>
                                        <field name="selling_price" widget="monetary" class="ml4"/>
                                    </div>
                                </div>
                                <footer class="mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="tag_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </div>
                                </footer>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>