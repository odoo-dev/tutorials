<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Estate Property" decoration-success="state in ('received', 'accepted', 'sold')" decoration-muted="state=='sold'" decoration-bf="state=='accepted'">
                <field name="name"/>
                <field name="postcode"/>
                <field name="date_availability" optional="hide"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="bedroom"/>
                <field name="living_area"/>
                <field name="tag_ids"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="My New House">
                <header>
                    <button name="action_sell" type="object" string="action_sell" invisible="state in ('sold', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="action_cancel" invisible="state in ('sold', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1 class="mb32">
                        <field name="name" class="mb16"/>
                    </h1>
                    <group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedroom"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="property_type_id" options="{'no_create_edit':True, 'no_create':True}"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <group>
                                <field name="offer_ids" readonly="state in ('sold', 'cancelled')"/>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
        <kanban default_group_by="property_type_id">
            <templates>
                    <t t-name="card">
                        <div>
                            <h1>
                            <field name="name"/>
                            </h1>
                            Expected price
                            <field name="expected_price"/>
                            <div t-if="record.state == 'new'">
                                This is new!
                            </div>
                            <div t-if="record.state == 'Offer Received'">
                                Best price:
                                <field name="best_price"/>
                            </div>
                            <div t-if="record.state == 'Offer Accepted'">
                                Selling price:
                                <field name="selling_price"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Delivery Carrier">
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="date_availability"/>
                <field name="expected_price"/>
                <field name="bedroom"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <filter name="postcode" context="{'group_by':'postcode'}"/>
                <filter name="available_filter" domain="['|', ('state', '=', 'new'), ('state', '=', 'received')]"/>
                <field name="living_area" filter_domain="[('living_area', '&gt;', self)]"/>
                
            </search>
        </field>
    </record>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available_filter': 1}</field>
    </record>

</odoo>
