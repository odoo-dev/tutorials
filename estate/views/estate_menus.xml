<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level -->
    <menuitem id="estate_menu_root" name="Estate" sequence="1"/>

    <!-- Main user menu -->
    <menuitem id="estate_menu_advertisement" name="Advertisements" sequence="1"
              parent="estate_menu_root"/>

    <menuitem id="estate_menu_settings" name="Settings" sequence="2"
              parent="estate_menu_root" groups="estate.estate_group_manager"/>

    <!-- Submenus -->
    <menuitem id="estate_menu_property" name="Properties" sequence="1"
              parent="estate_menu_advertisement" action="estate_property_action"/>

    <menuitem id="estate_menu_property_types" name="Property Types" sequence="1"
              parent="estate_menu_settings" action="estate_property_type_action"/>

    <menuitem id="estate_menu_property_tags" name="Property Tags" sequence="2"
              parent="estate_menu_settings" action="estate_property_tag_action"/>
</odoo>