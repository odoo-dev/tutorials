<?xml version="1.0"?>
<odoo>
    <record id="estate_offer_action" model="ir.actions.act_window">
        <field name="name">Property offer</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <record id="estate_offers_list_view" model="ir.ui.view">
        <field name="name">Estate Offers</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-success="status=='accepted'"
                decoration-danger="status=='refused'">
                <field name="price" string="Price" />
                <field name="partner_id" string="Partner" />
                <field name="validity" string="Validity" />
                <field name="date_deadline" string="Deadline" />
                <button name="action_confirm" type="object" icon="fa-check" />
                <button name="action_refuse" type="object" icon="fa-times" />
                <field name="property_type_id" string="Prop. Type" />
            </list>
        </field>
    </record>
</odoo>