<?xml version="1.0"?>

<odoo>

    <record id="estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate_properties.offer_list</field>
        <field name="model">estate_property.offer</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name='name'  string="Name"/>
                <field name='price' string="Price"/>
                <field name='status' string="Status"/>
                <field name='date_deadline' string="Deadline"/>
                <field name='partner_id' string="Partner"/>
                <field name='property_id' string="Property"/>
                <field name='validity' string="Validity"/>
                <button name='accept_offer_action' string="Accept" type='object' icon='fa-check'/>
                <button name='refuse_offer_action' string="Refuse" type='object' icon='fa-times'/>
            </list>
        </field>
    </record>

</odoo>

