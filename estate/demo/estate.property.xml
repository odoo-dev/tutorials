            <field name="living_area">0</field>
            <field name="facades">0</field>
            <field name="garage">False</field>
            <field name="salesperson_id" ref="base.user_admin"/>
            <field name="offer_ids" eval="[
                Command.create({
                    'price': 135000000,
                    'validity': 60,
                    'partner_id': ref('base.res_partner_6')
                }),
                Command.create({
                    'price': 148003400,
                    'partner_id': ref('base.res_partner_18'),
                    'date_deadline': datetime.now() + timedelta(days=60)
