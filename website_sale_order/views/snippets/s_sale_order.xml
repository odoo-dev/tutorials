<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<template id="sale_order_snippet" inherit_id="website.snippets" name="Sale Order Snipper">
        <xpath expr="//t[@id='installed_snippets_hook']" position="after">
            <t snippet-group="sale" t-snippet="website.s_snippet_group" string="Sale Order" />
        </xpath>
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="website_sale_order.s_sale_order_items_template" string="Sale Order" group="sale"/>
        </xpath>
</template>

<template id="s_sale_order_items_template" name="Sale Orders">
    <section class="s_sale_order_items">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-6 col-lg-4 pt16 pb16">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Order #S00001</h5>
                            <p class="card-text">Customer: Mitchell Admin</p>
                            <p class="card-text">Status: Sale</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<template id="s_sale_order_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-selector=".s_sale_order_items">
                <we-checkbox string="Confirm Orders"
                        data-attribute-name="confirmOrders"
                        data-select-data-attribute="true"
                        data-no-preview="true" />
                <we-select string="Layout" data-no-preview="true" data-attribute-name="layout" data-attribute-default-value="card">
                    <we-button title="Card" data-select-data-attribute="card">Card</we-button>
                    <we-button title="List" data-select-data-attribute="list">List</we-button>
                </we-select>
            </div>
        </xpath>
</template>

</odoo>
