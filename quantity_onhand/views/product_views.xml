<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_view_inherit_pos" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit.pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_update_quantity_on_hand']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@invisible='not show_forecasted_qty_status_button']//div"
                   position="replace"
            >
                <div class="o_field_widget o_stat_info">
                    <span class="o_stat_value d-flex gap-1">
                        <field name="qty_available" nolabel="1" class="oe_inline"/>
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                    <span class="o_stat_value d-flex gap-1">
                        <field name="virtual_available"
                               nolabel="1"
                               class="oe_inline"
                        />
                        <span class="o_stat_text oe_inline">Forecasted</span>
                    </span>
                </div>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view_pos_inherit" model="ir.ui.view">
        <field name="name">product.template.form.view.pos.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tooltip']" position="after">
                <label for="qty_available">On hand Quantity</label>
                <span class="d-flex gap-3">
                    <field name="qty_available" readonly="is_multi_locations" class="oe_inline"/>
                    <field name="uom_name" class="oe_inline" nolabel="1"/>
                    <button name="%(stock.action_product_stock_view)d"
                            type="action"
                            invisible="not is_multi_locations"
                            class="oe_stat_button oe_inline opacity-0 opacity-100-hover"
                            string="Update"
                    />
                </span>
            </xpath>
        </field>
    </record>
</odoo>
