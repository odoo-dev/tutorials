<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_split_move_wizard_form_view" model="ir.ui.view">
        <field name="name">account.split.move.wizard.form</field>
        <field name="model">account.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Invoice Wizard">
                <sheet>
                    <group>
                        <group >
                            <field name="parent_line_ids"
                                mode="tree"
                                widget="section_and_note_one2many"
                                help="These are the original invoice lines before the split."
                            >
                                <tree editable="bottom">
                                    <control>
                                        <create name="add_line_control" string="Add a line"/>
                                    </control>
                                    <field name="display_type" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="name" widget="section_and_note_text" column_invisible="True"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="tax" widget="many2many_tags"/>
                                    <field name="total" readonly="1"/>
                                    <button name="unlink" type="object" icon="fa-trash" title="Delete" class="btn-link"/>
                                </tree>
                            </field>
                        </group>
                        <group>
                            <field name="child_line_ids"
                                widget="section_and_note_one2many"
                                mode="tree"
                                help="These lines represent how the original invoice is being split into multiple invoices based on quantity."
                            >
                                <tree editable="bottom">
                                    <control>
                                        <create name="add_line_control" string="Add a line"/>
                                        <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                                    </control>
                                    <field name="display_type" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="name" widget="section_and_note_text"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="tax" widget="many2many_tags"/>
                                    <field name="total" readonly="1"/>
                                    <button name="unlink" type="object" icon="fa-trash" title="Delete" class="btn-link"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_split_invoices"
                        string="Confirm Split"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
