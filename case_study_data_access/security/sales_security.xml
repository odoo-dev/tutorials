<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_sale_salesman_team_lead" model="res.groups">
            <field name="name">Team Lead</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="rule_team_lead_access" model="ir.rule">
            <field name="name">Team Leads can see/modify all sales orders in their team</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['|','|', ('team_id.user_id', '=', user.id), ('user_id.crm_team_ids.user_id',
                'in', [user.id]), ('user_id', '=', 'False')]
            </field>
            <field name="groups" eval="[Command.link(ref('group_sale_salesman_team_lead'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>