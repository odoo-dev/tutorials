<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- New custom group with a unique XML ID -->
    <record id="group_team_leader_custom" model="res.groups">
        <field name="name">Sales: Team Leader</field>
        <field name="category_id" ref="base.module_category_sales_sales" />
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>

    <record id="sale_order_team_leader_rule" model="ir.rule">
        <field name="name">Sales Order: Team Leader Access</field>
        <field name="model_id" ref="sale.model_sale_order" />
        <field name="groups" eval="[(4, ref('case_study_data_access.group_team_leader_custom'))]" />
        <field name="domain_force">
            ['|','|',
            ('create_uid', '=', user.id),
            ('team_id.user_id', '=', user.id),
            ('user_id.crm_team_ids.user_id',
            'in', [user.id])
            ]
        </field>
    </record>

</odoo>