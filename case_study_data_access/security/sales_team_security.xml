<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="group_sale_salesman_team_leader" model="res.groups">
        <field name="name">User: Team Leader</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">the user will have access to all records of everyone in his/her team.</field>
    </record>

    <record id="sales_team.group_sale_salesman_all_leads" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sale_salesman_team_leader'))]"/>
    </record>

    <data noupdate="0">
        <record id="crm_rule_all_salesteam" model="ir.rule">
            <field name="name">Sales Team Leader</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('activity_user_id','in',user.crm_team_member_ids.user_id.id)]</field>
            <field name="groups" eval="[(4, ref('case_study_data_access.group_sale_salesman_team_leader'))]"/>
        </record>
    </data>
</odoo>