<odoo>
    <template id="contact_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <table class="table">
                    <hr />
                    <tr>
                        <th><b>Name</b></th>
                        <th><b>Email</b></th>
                    </tr>
                    
                    <t t-foreach="docs" t-as="contact">
                        <tr>
                                <td><span t-field="contact.name"/></td>
                                <td><span t-field="contact.email"/></td>
                        </tr>
                    </t>
                </table>
            </t>
        </t>
    </template>
</odoo>