<odoo>
    <record id="sale_branches_action" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="sale_branches_view_form" model="ir.ui.view">
        <field name="name">sale.branch.form</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <form string="Branches Form">
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <field name="sequence_id" />
                        <field name="code" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>