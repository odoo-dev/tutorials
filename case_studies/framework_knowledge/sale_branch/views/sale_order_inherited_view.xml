<odoo>
    <record id="sale_order_inherited_view" model="ir.ui.view">
        <field name="name">Sales Order Inherited View</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']" position="after">
                <group name="sales_order_branches">
                    <field name="branch_id" string="Branches"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>