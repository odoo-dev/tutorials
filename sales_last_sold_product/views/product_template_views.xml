<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_kanban_stock_inherit_view" model="ir.ui.view">
        <field name="name">Product Template Kanban Stock Inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_kanban_stock_view" />
        <field name="arch" type="xml">
            <xpath expr="//main/span" position="replace">
                <span>
                    <field name="list_price" widget="monetary"
                        options="{'currency_field': 'currency_id', 'field_digits': True}" /> / Units </span>
            </xpath>
            <xpath expr="//div[@groups='stock.group_stock_user']"
                position="replace">
                
                <span>
                    <field name="virtual_available" nolabel="1" class="oe_inline" />
                    On hand 
                    (<field name="qty_available" />)
                    </span>

            </xpath>

        </field>
    </record>
</odoo>
