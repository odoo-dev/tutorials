<odoo>
    <!-- list View for POS Orders with Salesperson -->
    <record id="view_pos_order_list_salesperson" model="ir.ui.view">
        <field name="name">view.pos.order.list.salesperson</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="salesperson_id" string="Salesperson"/>
            </list>
        </field>
    </record>

    <!-- Action to Show Orders Per Salesperson -->
    <record id="action_pos_orders_by_salesperson" model="ir.actions.act_window">
        <field name="name">Salesperson Orders</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list</field>
        <field name="domain">[("salesperson_id", "!=", False)]</field>
    </record>
</odoo>
