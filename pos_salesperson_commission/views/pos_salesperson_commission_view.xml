<!-- pos_salesperson_commission_view.xml -->
<odoo>
    <record id="pos_salesperson_commission_view_list" model="ir.ui.view">
        <field name="name">pos.salesperson.commission.list</field>
        <field name="model">pos.salesperson.commission</field>
        <field name="arch" type="xml">
            <list>
                <field name="user_id"/>
                <field name="order_ids" widget="many2many_tags"/>
                <!-- <field name="commission"/> -->
            </list>
        </field>
    </record>

    <record id="pos_salesperson_commission_action" model="ir.actions.act_window">
        <field name="name">Salesperson Commissions</field>
        <field name="res_model">pos.salesperson.commission</field>
        <field name="view_mode">list</field>
    </record>
</odoo>