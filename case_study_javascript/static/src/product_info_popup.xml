<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">
    <t t-name="case_study_javascript.ProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('financials-order')]" position="attributes">
            <attribute name="class" add="border-bottom" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('financials-order')]" position="after">
            <div class="pt-3 text-start">
                <h3 class="section-title">Logistics</h3>
                <table class="table table-borderless mb-0">
                    <tr>
                        <td>Weight</td>
                        <td><t t-esc="props.product.weight"/></td>
                    </tr>
                    <tr>
                        <td>Volume</td>
                        <td><t t-esc="props.product.volume"/></td>
                    </tr>
                </table>
            </div>
        </xpath>
    </t>
</templates>
