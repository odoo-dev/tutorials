<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="estate_property_offer_list_view_inherit" model="ir.ui.view">
        <field name="name">estate.property.offer.list.inherit</field>
        <field name="model">estate.property.offer</field>
        <field name="inherit_id" ref="estate.estate_property_offer_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_offer_accept_btn']" position="attributes">
                <attribute name="invisible" add="property_sale_type == 'auction'" separator="or"/>
            </xpath>
            <xpath expr="//button[@name='action_offer_reject_btn']" position="attributes">
                <attribute name="invisible" add="property_sale_type == 'auction'" separator="or"/>
            </xpath>
        </field>
   </record>
</odoo>