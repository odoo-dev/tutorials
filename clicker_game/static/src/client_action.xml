<templates xml:space="preserve">
    <t t-name="clicker_game.clientaction">
        <Notebook orientation="horizontal">
            <t t-set-slot="page_1" title="'Clicker'" isVisible="true">
                <div class="p-2">
                    <span>
                        Clicks: <ClickValue value="clicker.clicks"/>
                    </span>
                </div>
                <div t-if="clicker.levels.level gte 1" class="p-1 border-1">
                    <h2>Bots</h2>
                    <div class="d-flex gap-2">
                        <div class="p-2 shadow-sm">
                            <div>
                                <span>
                                    <t t-esc="clicker.clickBots.bots"/>x ClickBots (10 clicks/10seconds)
                                    <i class="fa fa-bug"></i>
                                </span>
                            </div>
                            <div class="p-3">
                                <button t-att-disabled="clicker.clicks.count &lt; 1000" t-on-click="clicker.buyClickBot" class="btn btn-primary ms-2">
                                    <span>
                                        Buy clickbot (1000 clicks)
                                    </span>
                                </button>
                            </div>
                        </div>
                        <div class="p-2 shadow-sm">
                            <div>
                                <span>
                                    <t t-esc="clicker.bigClickBots.bots"/>x bigBot (100 clicks/10seconds)
                                    <i class="fa fa-bug"></i>
                                </span>
                            </div>
                            <div class="p-3">
                                <button t-att-disabled="clicker.clicks.count &lt; 5000" t-on-click="clicker.buyBigClickBot" class="btn btn-primary ms-2">
                                    <span>
                                        Buy bigbot (5000 clicks)
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div t-if="clicker.levels.level gte 3" class="p-1 border-1">
                    <h2>Power multiplier</h2>
                    <div class="d-flex gap-2">
                        <div class="p-2 shadow-sm">
                            <div>
                                <span>
                                    <t t-esc="clicker.powerMultiplier.multiplier"/>x 
                                    <i class="fa fa-bug"></i>
                                </span>
                            </div>
                            <div class="p-3">
                                <button t-att-disabled="clicker.clicks.count &lt; 50000" t-on-click="clicker.buyPowerMultiplier" class="btn btn-primary ms-2">
                                    <span>
                                        Buy Power Mulitplier (50000 clicks)
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <t t-set-slot="page_2" title="'Trees &amp; Fruits'" class="p-2" isVisible="true">
                <div t-if="clicker.levels.level gte 4" class="p-1 border-1">
                    <h2>Trees</h2>    
                    <div class="d-flex gap-2">
                        <div class="p-2 shadow-sm">
                            <div>
                                <span>
                                    <t t-esc="clicker.pearsTree"/>x pearTree (1x pear /30 seconds)
                                    <i class="fa fa-tree"></i>                                
                                </span>
                            </div>
                            <div class="p-3">
                                <button t-att-disabled="clicker.clicks.count &lt; 1000000" t-on-click="clicker.buyPearsTree" class="btn btn-primary ms-2">
                                    <span>
                                        Buy pearTree (1000000 clicks)
                                    </span>
                                </button>
                            </div>
                        </div>
                        <div class="p-2 shadow-sm">
                            <div>
                                <span>
                                    <t t-esc="clicker.cherriesTree"/>x cherryTree (1x cherry /30 seconds)
                                    <i class="fa fa-tree"></i>                                
                                </span>
                            </div>
                            <div class="p-3">
                                <button t-att-disabled="clicker.clicks.count &lt; 1000000" t-on-click="clicker.buyCherriesTree" class="btn btn-primary ms-2">
                                    <span>
                                        Buy cherryTree (1000000 clicks)
                                    </span>
                                </button>
                            </div>
                            <div class="p-3">
                                <button t-att-disabled="clicker.clicks.count &lt; 1000000" t-on-click="clicker.buyPeachesTree" class="btn btn-primary ms-2">
                                    <span>
                                        Buy peachTree (1000000 clicks)
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div t-if="clicker.levels.level gte 4" class="p-1 border-1">
                    <h2>Fruits</h2>    
                    <div class="d-flex gap-2">
                        <div class="p-2 shadow-sm">
                            <span>
                                <t t-esc="clicker.pears"/>x pear                                
                            </span>
                        </div>
                        <div class="p-2 shadow-sm">
                            <span>
                                <t t-esc="clicker.cherries"/>x cherry                                                                   
                            </span>
                        </div>
                        <div class="p-2 shadow-sm">
                            <span>
                                <t t-esc="clicker.peaches"/>x peaches                                                                   
                            </span>
                        </div>
                    </div>
                </div>
            </t>
        </Notebook>
    </t>
</templates>