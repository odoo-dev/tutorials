<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="combo_choices.product_combo_view_form" model="ir.ui.view">
        <field name="name">product.combo.form.inherit.combo.choices</field>
        <field name="model">product.combo</field>
        <field name="inherit_id" ref="product.product_combo_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="after">
                <group>
                    <div>
                        <div>
                            <label for="qty_free" string="Includes"/>
                            <field name="qty_free" class="oe_inline"/>
                            <span>free</span>
                        </div>
                        <div>
                            <label for="qty_max" string="Maximum" />
                            <field name="qty_max" class="oe_inline"/>
                            <span>items</span>
                        </div>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>