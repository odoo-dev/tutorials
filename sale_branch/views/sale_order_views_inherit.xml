<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_branch.view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sale_branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet//group[1]" position="inside">
                <field name="branch_id" placeholder="Branch" />
            </xpath>
        </field>
    </record>
</odoo>