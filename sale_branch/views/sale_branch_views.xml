<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_sale_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu: under Sales / Configuration -->
    <record id="menu_sale_branch_parent" model="ir.ui.menu">
        <field name="name">Branches</field>
        <field name="parent_id" ref="sale.menu_sale_config" />
        <field name="sequence">10</field>
    </record>

    <record id="menu_sale_branch" model="ir.ui.menu">
        <field name="name">Branches</field>
        <field name="parent_id" ref="menu_sale_branch_parent" />
        <field name="action" ref="action_sale_branch" />
        <field name="sequence">10</field>
    </record>

    <!-- List view -->
    <record id="view_sale_branch_list" model="ir.ui.view">
        <field name="name">sale.branch.list</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="sequence_id" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_sale_branch_form" model="ir.ui.view">
        <field name="name">sale.branch.form</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <form string="Sale Branch">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="sequence_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>