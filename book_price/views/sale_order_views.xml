<odoo>
    <record id="view_order_form_inherit_book_price" model="ir.ui.view">
        <field name="name">sale.order.form.book.price</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="before">
                <field name="book_price"/>
            </xpath>

        </field>
    </record>
</odoo>
