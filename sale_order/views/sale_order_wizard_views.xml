<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_action" model="ir.actions.act_window">
        <field name="name">Divide Sale Order Price</field>
        <field name="res_model">sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="wizard_view_form" model="ir.ui.view">
        <field name="name">wizard.form.view</field>
        <field name="model">sale.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Divide Cost">
                <field name="sale_order_wizard_line_id">
                    <list>
                        <field name="name"/>
                        <field name="price" />
                    </list>
                </field>
                <footer>
                    <button string="Divide" class="btn-primary"/>
                    <button string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
