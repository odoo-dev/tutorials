<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_sale_order_form_sale_order" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.wizard.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_template_id']" position="after">
                <button name="%(wizard_action)d" type="action" icon="fa-share-alt"/>
            </xpath>
            <xpath expr="//field[@name='price_total'][@invisible='is_downpayment']" position="after">
                <field string='Division' name="sale_tag_line_id" widget='many2many_tags' options="{'color_field': 'color'}"  readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>

