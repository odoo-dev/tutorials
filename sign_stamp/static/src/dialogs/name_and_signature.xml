<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="sign_stamp.Stamp_SVG" name="SVG Stamp">
        <svg t-att-width="width" t-att-height="height" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
            <defs>
                <style type="text/css">
                    @font-face {
                        font-family: "font";
                        src: url(data:font/ttf;base64,<t t-esc="font"/>) format("woff");
                        font-weight: normal;
                        font-style: normal;
                    }
                </style>
            </defs>

            <image x="10%" y="20%" width="37%" height="60%" t-attf-href="{{logo}}"/>

            <t t-if="company">
                <text t-esc="company" x="49%" t-att-y="height * 2 / 8"
                    t-att-font-size="height * 1 / 13"
                    t-att-textLength="width * 1 / 3 * Math.min(1, company.length / 7)"
                    t-att-lengthAdjust="'spacing' + 'AndGlyphs'"
                    t-attf-style="font-family:'font'; stroke: none; fill: {{color}};"
                    text-anchor="start"/>
            </t>

            <t t-if="address">
                <text t-esc="address" x="49%" t-att-y="height * 3 / 8"
                    t-att-font-size="height * 1 / 13"
                    t-att-textLength="width * 1 / 3 * Math.min(1, address.length / 7)"
                    t-att-lengthAdjust="'spacing' + 'AndGlyphs'"
                    t-attf-style="font-family:'font'; stroke: none; fill: {{color}};"
                    text-anchor="start"/>
            </t>

            <t t-if="city">
                <text t-esc="city" x="49%" t-att-y="height * 4 / 8"
                    t-att-font-size="height * 1 / 13"
                    t-att-textLength="width * 1 / 3 * Math.min(1, city.length / 7)"
                    t-att-lengthAdjust="'spacing' + 'AndGlyphs'"
                    t-attf-style="font-family:'font'; stroke: none; fill: {{color}};"
                    text-anchor="start"/>
            </t>

            <t t-if="country">
                <text t-esc="country" x="49%" t-att-y="height * 5 / 8"
                    t-att-font-size="height * 1 / 13"
                    t-att-textLength="width * 1 / 3 * Math.min(1, country.length / 7)"
                    t-att-lengthAdjust="'spacing' + 'AndGlyphs'"
                    t-attf-style="font-family:'font'; stroke: none; fill: {{color}};"
                    text-anchor="start"/>
            </t>

            <t t-if="vat">
                <text t-esc="vat" x="49%" t-att-y="height * 6 / 8"
                    t-att-font-size="height * 1 / 13"
                    t-att-textLength="width * 1 / 3 * Math.min(1, vat.length / 7)"
                    t-att-lengthAdjust="'spacing' + 'AndGlyphs'"
                    t-attf-style="font-family:'font'; stroke: none; fill: {{color}};"
                    text-anchor="start"/>
            </t>
        </svg>
    </t>
</templates>
