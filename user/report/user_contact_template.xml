<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_user_contact">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="user">
                                <tr>

                                    <td>
                                        <span t-field="user.name" />
                                    </td>
                                    <td>
                                        <span t-field="user.email" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>