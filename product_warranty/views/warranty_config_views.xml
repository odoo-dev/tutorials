<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warranty_config_list" model="ir.ui.view">
        <field name="name">warranty.config.list</field>
        <field name="model">product.warranty.config</field>
        <field name="arch" type="xml">
            <list string="Warranty Configuration">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="percentage"/>
            </list>
        </field>
    </record>


    <record id="view_warranty_config_form" model="ir.ui.view">
        <field name="name">warranty.config.form</field>
        <field name="model">product.warranty.config</field>
        <field name="arch" type="xml">
            <form string="Warranty Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_tmpl_id"/>
                        <field name="percentage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_warranty_config" model="ir.actions.act_window">
        <field name="name">Warranty Configuration</field>
        <field name="res_model">product.warranty.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
