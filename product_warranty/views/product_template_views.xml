<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_product_warranty" model="ir.ui.view">
        <field name="name">product.template.form.inherit.product.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Warranty Configuration">
                    <group name="product_warranty_checkbox">
                        <field name="is_warranty_available"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
