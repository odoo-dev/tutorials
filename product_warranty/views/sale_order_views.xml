<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_inherit_product_warranty" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.product.warranty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='so_button_below_order_lines']" position="inside">
                <button
                    string="Add Warranty"
                    name="%(action_add_product_warranty)d"
                    invisible="not order_line"
                    type="action"
                />
            </xpath>
        </field>
    </record>
</odoo>
