<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_warranty_wizard_list" model="ir.ui.view">
        <field name="name">product.warranty.wizard.list</field>
        <field name="model">product.warranty.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="allowed_product_ids" invisible="1"/>
                <field name="wizard_line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id" domain="[('id', 'in', parent.allowed_product_ids)]" readonly="1"/>
                        <field name="warranty_id"/>
                        <!-- <field name="end_date"/> -->
                    </list>
                </field>
                <footer>
                    <button string="Add Warranty" name="action_add_warranty" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_add_product_warranty" model="ir.actions.act_window">
        <field name="name">Configure Warranty</field>
        <field name="res_model">product.warranty.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
