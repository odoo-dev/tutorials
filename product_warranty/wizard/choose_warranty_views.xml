<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="choose_warranty_view_form" model="ir.ui.view">
        <field name="name">choose.warranty.wizard.form</field>
        <field name="model">choose.warranty</field>
        <field name="arch" type="xml">
            <form string="Choose Warranty">
                <group>
                    <group>
                        <field name="order_id" invisible="1"/>
                        <field name="product_id" domain="[('is_warranty', '=', True)]"/>
                        <field name="warranty_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_add_warranty" type="object" string="Add Warranty" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
