<odoo>
  <data>
    <record id="product_template_form_view_inherit_rental_deposit" model="ir.ui.view">
      <field name="name">product.template.form.inherit.rental.deposit</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="sale_renting.product_template_form_view_rental"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='extra_daily']" position="after">
          <field name="require_deposit"/>
          <field name="deposit_amount" widget="monetary" invisible="require_deposit == False"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
