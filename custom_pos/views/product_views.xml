<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group" position="inside">
                <group string="POS Description" name="pos_description" invisible="not available_in_pos">
                    <field name="pos_description"
                           placeholder="add point of sale description"
                           nolabel="1"
                           colspan="2"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='pos']" position="inside">
                <field name="alternative_name" invisible="not available_in_pos"/>
                <field name="pos_alternative_product_ids" widget="many2many_tags"
                    domain="[('id', '!=', id), '|', ('company_id', '=', company_id), ('company_id', '=', False)]"
                    invisible="not available_in_pos"
                    placeholder="Displayed in the product info popup within POS."/>
            </xpath>
        </field>
    </record>
</odoo>
