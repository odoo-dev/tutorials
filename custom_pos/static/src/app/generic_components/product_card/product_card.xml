<?xml version="1.0" encoding="UTF-8"?>
<template id="template" xml:space="preserve">
    <t t-name="custom_pos.AlternativeName" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-img')]" position="before">
            <h1 t-if="props.availableQty" t-esc="props.availableQty"
                class="position-absolute top-0 start-0 h1 fw-bolder m-0 mt-auto px-1 text-bg-success bg-opacity-50 rounded-top" />
        </xpath>
        <xpath expr="//div[hasclass('product-content')]" position="attributes">
            <attribute name="t-att-class">{'h-100 d-flex justify-content-center align-items-center text-center' : !props.imageUrl}</attribute>
        </xpath>
    </t>
</template>
