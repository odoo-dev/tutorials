<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_pos.updateQty" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('status-buttons')]//Input" position="before">
            <button class="btn btn-primary btn-lg mx-1" t-on-click="quantityService.fetchProductQty">
                <i class="fa fa-refresh fa-lg fa-fw"/>
            </button>
        </xpath>
    </t>
</templates>
