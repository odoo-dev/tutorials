<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_pos.AvailableQty" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="availableQty">productQuantities[product.raw.product_tmpl_id]?.toString() || 'N/A'</attribute>
        </xpath>
    </t>
</templates>
