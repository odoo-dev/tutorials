<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_tds_process_queued" model="ir.cron">
        <field name="name">TDS Validation: Process queued records</field>
        <field name="model_id" ref="model_tds_validation"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queued()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_tds_retry_webhooks" model="ir.cron">
        <field name="name">TDS Validation: Retry undelivered webhooks</field>
        <field name="model_id" ref="model_tds_validation"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_webhooks()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
