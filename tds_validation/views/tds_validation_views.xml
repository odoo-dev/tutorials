<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_tds_validation" model="ir.sequence">
        <field name="name">TDS Validation</field>
        <field name="code">tds.validation</field>
        <field name="prefix">TDS/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="view_tds_validation_form" model="ir.ui.view">
        <field name="name">tds.validation.form</field>
        <field name="model">tds.validation</field>
        <field name="arch" type="xml">
            <form string="TDS Validation">
                <header>
                    <button name="action_queue_validation" type="object"
                            string="▶ Queue for Processing" class="btn-primary"
                            invisible="state not in ['draft']"/>
                    <button name="action_reset" type="object"
                            string="Reset to Draft"
                            invisible="state not in ['failed','queued']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,queued,running,done,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group string="Input Files">
                        <field name="tds_file" widget="binary"
                               filename="tds_filename"
                               string="TDS/TCS Input File (.txt/.fvu)"
                               readonly="state != 'draft'"/>
                        <field name="tds_filename" invisible="1"/>

                        <field name="consolidate_file" widget="binary"
                               filename="consolidate_filename"
                               string="Challan/Consolidate File (.csi)"
                               readonly="state != 'draft'"/>
                        <field name="consolidate_filename" invisible="1"/>
                    </group>

                    <group string="API / Integration" name="api_group"
                           invisible="not is_api_request">
                        <field name="is_api_request" invisible="1"/>
                        <field name="request_id" string="Request ID"/>
                        <field name="request_date" string="Request Date"/>
                        <field name="checksum" string="Checksum"/>
                        <field name="checksum_valid" string="Checksum Valid"/>
                        <field name="notes" string="Notes"/>
                        <field name="webhook_url" string="Webhook URL"/>
                        <field name="webhook_sent" string="Webhook Sent"/>
                    </group>

                    <group string="FVU Version Check" name="fvu_version_group">
                        <field name="fvu_version_local" string="Local Version"/>
                        <field name="fvu_version_server" string="Server Latest"/>
                        <field name="fvu_version_status" widget="badge"
                               decoration-success="fvu_version_status == 'current'"
                               decoration-warning="fvu_version_status == 'warn' or fvu_version_status == 'unverified'"
                               decoration-danger="fvu_version_status == 'old'"
                               decoration-info="fvu_version_status == 'unknown'"/>
                    </group>

                    <group string="Error Details"
                           invisible="state != 'failed'">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>

                    <group string="Execution Log" name="execution_log_group"
                           invisible="not execution_log">
                        <field name="execution_log" readonly="1" nolabel="1"
                               class="tds-execution-log"/>
                    </group>

                    <notebook invisible="state != 'done'">
                        <page string="Output Files">
                            <field name="output_attachment_ids"
                                   widget="many2many_binary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tds_validation_list" model="ir.ui.view">
        <field name="name">tds.validation.list</field>
        <field name="model">tds.validation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tds_filename"/>
                <field name="fvu_version_local" string="Version"/>
                <field name="fvu_version_status" widget="badge"
                       decoration-success="fvu_version_status == 'current'"
                       decoration-warning="fvu_version_status == 'warn' or fvu_version_status == 'unverified'"
                       decoration-danger="fvu_version_status == 'old'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'running' or state == 'queued'"
                       decoration-muted="state == 'draft'"/>
                <field name="queued_at" string="Queued At"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_tds_validation" model="ir.actions.act_window">
        <field name="name">TDS Validation</field>
        <field name="res_model">tds.validation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_draft': 1}</field>
    </record>

    <menuitem id="menu_tds_root" name="TDS Validation" sequence="99"/>
    <menuitem id="menu_tds_list" name="Validations"
              parent="menu_tds_root" action="action_tds_validation" sequence="1"/>

</odoo>
