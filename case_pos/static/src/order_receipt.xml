<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="case_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[p[text()='Powered by Odoo'] and div[@id='order-date']]" position="before">
            <div class="pos-receipt-order-data">
                <p><t t-out="props.data.headerData.congratulatory_text"/></p>
            </div>
        </xpath>
    </t>
</templates>
