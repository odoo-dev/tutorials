<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="case_pos.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ControlButtons" position="after">
            <button class="remove-item btn btn-light btn-lg" t-on-click="onRemoveClick" t-if="!currentOrder?.is_empty() and pos.get_order()?.uiState.selected_orderline_uuid">Remove item</button>
        </xpath>
    </t>

</templates>
