<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_config_settings" model="ir.ui.view">
            <field name="name">view.res.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block name="operations_setting_container" position="inside">
                    <setting>
                        <div class="content-group">
                            <label string="Expiry Duration" for="expiry_duration" class="col-lg-3 o_dark_label"/>
                            <field name="expiry_duration" placeholder="Enter Expiry Duration" />
                        </div>
                        <div>
                            <label string="User" for="user_ids"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </div>
                    </setting>
                </block>
            </field>
        </record>
    </data>
</odoo>
