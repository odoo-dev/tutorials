<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_view_rental" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.deposit.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_renting.product_template_form_view_rental"/>
        <field name="arch" type="xml">
            <xpath expr="//page//group//field[@name='extra_daily']/.." position="after">
                <field name="require_deposit"/>
                <field name="deposit_amount" invisible="not require_deposit" widget="monetary"/>
            </xpath>
        </field>
    </record>
</odoo>
