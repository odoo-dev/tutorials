<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="name">product.view.kanban.catalog.inherit.stock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_kanban_catalog"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@t-if='record.default_code.value']" position="replace">
                <field name="default_code"/>
            </xpath>
            <xpath expr="//div[@name='o_kanban_qty_available']" position="inside">
                <field name="virtual_available" invisible="1"/>
                <t t-if="record.virtual_available.raw_value - record.qty_available.raw_value &gt; 0">
                    <span class="o_text_success"> 
                        (+<t t-esc="record.virtual_available.raw_value - record.qty_available.raw_value"/>)
                    </span>
                </t>
                <t t-elif="record.virtual_available.raw_value - record.qty_available.raw_value &lt; 0">
                    <span class="o_text_alert"> 
                        (<t t-esc="record.virtual_available.raw_value - record.qty_available.raw_value"/>)
                    </span>
                </t>
                <t t-else="">
                    <span>(0)</span>
                </t>
            </xpath>
            <xpath expr="//div//field[@name='product_template_attribute_value_ids']" position="after">
                <span>
                    <field name="last_invoice_time_diff"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
