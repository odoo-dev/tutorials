<odoo>
  <data>
    <record id="view_inherit_pos_order_salesperson_form" model="ir.ui.view">
      <field name="name">pos.order.inherit.salesperson</field>
      <field name="model">pos.order</field>
      <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook//page[@name='products']" position="before">
          <page string="Salesperson">
          <group>
            <field name='sales_person_id'/>
          </group>
          </page>
        </xpath>
      </field>
    </record>

    <record id="view_pos_order_inherit_salesperson_list" model="ir.ui.view">
      <field name="name">pos.order.inherit.salesperson</field>
      <field name="model">pos.order</field>
      <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="before">
          <field name='sales_person_id'/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
