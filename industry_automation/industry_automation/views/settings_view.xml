<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="industry_automation_settings_action" model="ir.actions.act_window">
        <field name="name">Industry Automation Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="base.res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'industry_automation'}</field>
    </record>

    <record id="industry_automation_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.industry_automation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app name="industry_automation" string="Industry Automation" data-string="Industry Automation">
                    <block title="Upload Settings">
                        <setting id="industry_default_project" help="Default project used to create tasks for uploaded dump files.">
                            <field name="industry_automation_project_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
