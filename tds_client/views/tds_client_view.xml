<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for auto-numbering -->
    <data>
        <record id="seq_tds_client" model="ir.sequence">
            <field name="name">TDS Client</field>
            <field name="code">tds.client</field>
            <field name="prefix">TDS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>
    </data>


    <!-- FORM VIEW -->
    <record id="view_tds_client_form" model="ir.ui.view">
        <field name="name">tds.client.form</field>
        <field name="model">tds.client</field>
        <field name="arch" type="xml">
            <form string="TDS Client">
                <header>
                    <button name="action_send_to_server" type="object" class="btn-primary" string="Send to Server"
                            invisible="state not in ['draft']"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state not in ['failed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sending,done,failed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Database Identification -->
                    <group string="Database Info">
                        <field name="db_instance_uuid"/>
                        <field name="db_name"/>
                        <field name="company_id"/>
                    </group>

                    <!-- Input Files -->
                    <group string="Input Files">
                        <field name="tds_file" widget="binary" filename="tds_filename"
                               string="TDS/TCS Input File (.txt/.fvu)" readonly="state != 'draft'"/>
                        <field name="tds_filename" invisible="1"/>

                        <field name="csi_file" widget="binary" filename="csi_filename"
                               string="Challan File (.csi) — Optional" readonly="state != 'draft'"/>
                        <field name="csi_filename" invisible="1"/>

                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <!-- LIST VIEW   -->
    <record id="view_tds_client_list" model="ir.ui.view">
        <field name="name">tds.client.list</field>
        <field name="model">tds.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="db_instance_uuid"/>
                <field name="db_name"/>
                <field name="company_id"/>
                <field name="tds_filename"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'" decoration-warning="state == 'sending'"
                       decoration-muted="state == 'draft'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- WINDOW ACTION + MENU    -->
    <record id="action_tds_client" model="ir.actions.act_window">
        <field name="name">TDS Client</field>
        <field name="res_model">tds.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tds_client_root" name="TDS Client" sequence="98"/>
    <menuitem id="menu_tds_client_list" name="Requests" parent="menu_tds_client_root" action="action_tds_client"
              sequence="1"/>

</odoo>
