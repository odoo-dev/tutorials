<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for auto-numbering -->
    <record id="seq_tds_client" model="ir.sequence">
        <field name="name">TDS Client</field>
        <field name="code">tds.client</field>
        <field name="prefix">TDSCLI/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- FORM VIEW                                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="view_tds_client_form" model="ir.ui.view">
        <field name="name">tds.client.form</field>
        <field name="model">tds.client</field>
        <field name="arch" type="xml">
            <form string="TDS Client">
                <header>
                    <button name="action_send_to_server" type="object"
                            string="🚀 Send to Server" class="btn-primary"
                            invisible="state not in ['draft']"/>
                    <button name="action_reset" type="object"
                            string="Reset to Draft"
                            invisible="state not in ['failed']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sending,done,failed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Input Files -->
                    <group string="Input Files">
                        <field name="tds_file" widget="binary"
                               filename="tds_filename"
                               string="TDS/TCS Input File (.txt/.fvu)"
                               readonly="state != 'draft'"/>
                        <field name="tds_filename" invisible="1"/>

                        <field name="csi_file" widget="binary"
                               filename="csi_filename"
                               string="Challan File (.csi) — Optional"
                               readonly="state != 'draft'"/>
                        <field name="csi_filename" invisible="1"/>
                    </group>

                    <!-- Checksum -->
                    <group string="Checksum">
                        <field name="compute_checksum"
                               readonly="state != 'draft'"/>
                        <field name="checksum" readonly="1"
                               placeholder="Auto-computed SHA-256"/>
                        <field name="checksum_valid" widget="badge"
                               readonly="1"
                               decoration-success="checksum_valid == True"
                               decoration-danger="checksum_valid == False"/>
                    </group>

                    <!-- Metadata -->
                    <group string="Metadata">
                        <field name="request_id" readonly="state != 'draft'"
                               placeholder="External reference (optional)"/>
                        <field name="request_date" readonly="state != 'draft'"
                               placeholder="YYYY-MM-DD (optional)"/>
                        <field name="server_url"
                               readonly="state != 'draft'"
                               placeholder="Leave empty for default"/>
                        <field name="notes" readonly="state != 'draft'"
                               placeholder="Optional notes"/>
                    </group>

                    <!-- Server Response Info -->
                    <group string="Server Response"
                           invisible="state not in ['done', 'failed']">
                        <field name="server_state" readonly="1"
                               string="Server State"/>
                        <button name="action_view_raw_response" type="object"
                                string="📄 View Raw Response"
                                invisible="not raw_response"
                                class="btn-link"/>
                        <field name="raw_response" invisible="1"/>
                    </group>

                    <!-- Error Details -->
                    <group string="Error Details"
                           invisible="state != 'failed'">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>

                    <!-- Output Files -->
                    <notebook invisible="state != 'done'">
                        <page string="Output Files">
                            <field name="output_attachment_ids"
                                   widget="many2many_binary" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- RAW RESPONSE FORM (popup)                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="view_tds_client_raw_form" model="ir.ui.view">
        <field name="name">tds.client.raw.form</field>
        <field name="model">tds.client</field>
        <field name="arch" type="xml">
            <form string="Raw Response" create="false" edit="false">
                <sheet>
                    <group string="Raw Server Response">
                        <field name="raw_response" readonly="1" nolabel="1"
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- LIST VIEW                                                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="view_tds_client_list" model="ir.ui.view">
        <field name="name">tds.client.list</field>
        <field name="model">tds.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tds_filename"/>
                <field name="request_id"/>
                <field name="checksum_valid" widget="badge"
                       string="Checksum"
                       decoration-success="checksum_valid == True"
                       decoration-danger="checksum_valid == False"/>
                <field name="server_state" string="Server"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'sending'"
                       decoration-muted="state == 'draft'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- WINDOW ACTION + MENU                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <record id="action_tds_client" model="ir.actions.act_window">
        <field name="name">TDS Client</field>
        <field name="res_model">tds.client</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_state_draft': 1}</field>
    </record>

    <menuitem id="menu_tds_client_root" name="TDS Client" sequence="98"/>
    <menuitem id="menu_tds_client_list" name="Requests"
              parent="menu_tds_client_root" action="action_tds_client" sequence="1"/>

</odoo>
