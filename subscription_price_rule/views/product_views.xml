<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide the 'open_pricelist_rules' button in the product template form -->
    <record id="product_template_view_form_inherit_pricelist" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.pricelist</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='open_pricelist_rules']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Make subscription pricing editable and modify the subscription pricing page -->
    <record id="product_template_view_form_inherit_subscription" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.subscription</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_subscription.product_template_view_form_recurring"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_subscription_pricing_ids']/list" position="attributes">
                <attribute name="editable"></attribute>
            </xpath>
            <xpath expr="//field[@name='product_subscription_pricing_ids']/list" position="inside">
                <field name="min_quantity" optional="1" />
                <field name="product_id" optional="1" />
                <field name="date_start" optional="1" />
                <field name="date_end" optional="1" />
                <field name="company_id" optional="1" />
            </xpath>
            <xpath expr="//page[@name='subscription_pricing']" position="attributes">
                <attribute name="string">Pricing</attribute>
                <attribute name="invisible">rent_ok or not recurring_invoice</attribute>
            </xpath>

            <xpath expr="//page[@name='subscription_pricing']" position="inside">
                <div class="text-info text-center align-center" invisible="is_pricelist_available">
                    Activate pricelist setting if you want to set specific price rules
                </div>
            </xpath>
            <xpath expr="//field[@name='product_subscription_pricing_ids']" position="before">
                <div class="p-2">
                    <label for="list_price" string="Subscription Price" />
                    <field colspan="2" name="list_price" string="Rental Price"/>
                    <span>per day</span>
                </div>
            </xpath>
            <xpath expr="//field[@name='product_subscription_pricing_ids']" position="attributes">
                <attribute name="invisible">not is_pricelist_available</attribute>
            </xpath>

        </field>
    </record>
</odoo>
