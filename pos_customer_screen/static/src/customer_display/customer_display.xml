<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="pos_customer_screen.CustomerDisplay"
        t-inherit="point_of_sale.CustomerDisplay"
        t-inherit-mode="extension">
        <xpath expr="//div[@t-if='order.amount and !order.finalized']/div" position="inside">
            <div class="d-flex justify-content-end gap-3" t-if="order.customer_name">
                <div class="text-end">Customer</div>
                <div class="text-end" t-esc="order.customer_name"/>
            </div>
            <div class="d-flex justify-content-end gap-3" t-if="order.amountPerGuest">
                <div class="text-end">Amount per guest</div>
                <div class="text-end" t-esc="order.amountPerGuest"/>
            </div>
        </xpath>
        
        <xpath expr="//OrderWidget" position="attributes">
            <attribute name="totalRefundItems">order.totalRefundItems</attribute>
        </xpath>
    </t>
</templates>
