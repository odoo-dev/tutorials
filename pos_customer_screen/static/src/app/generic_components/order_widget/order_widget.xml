<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="pos_customer_screen.OrderWidget"
        t-inherit="point_of_sale.OrderWidget"
        t-inherit-mode="extension">
        <xpath expr="//div[@t-ref='scrollable']/t" position="replace">
            <t t-foreach="props.lines" t-as="line" t-key="line_index">
                <t t-if="!line.isRefund">
                    <t t-if="props.slots?.default" t-slot="default" line="line"/>
                    <Orderline t-else="" line="line" />
                </t>
            </t>
            <t t-if="props.totalRefundItems > 0">
                <div class="mt-5 refund-section p-2 border-top border-danger mt-2">
                    <h4 class="text-danger text-center fw-bold">Refund Items</h4>
                    <t t-foreach="props.lines" t-as="line" t-key="line_index">
                        <t t-if="line.isRefund">
                            <t t-if="props.slots?.default" t-slot="default" line="line"/>
                            <Orderline t-else="" line="line" />
                        </t>
                    </t>
                </div>
            </t>
        </xpath>
    </t>
</templates>
