<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_hide_pricelist" model="ir.ui.view">
        <field name="name">product.template.form.inherit.hide.pricelist</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='open_pricelist_rules']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit_rental_editable" model="ir.ui.view">
        <field name="name">product.template.form.inherit.rental.editable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_pricing_ids']/list" position="attributes">
                <attribute name="editable"></attribute>
            </xpath>
            <xpath expr="//field[@name='product_pricing_ids']/list" position="inside">
                <field name="product_template_id" />
                <field name="min_quantity" optional="1" />
                <field name="product_id" optional="1" />
                <field name="date_start" optional="1" />
                <field name="date_end" optional="1" />
                <field name="company_id" optional="1" />
            </xpath>
            <xpath expr="//page[@name='pricing']" position="attributes">
                <attribute name="string">Pricing</attribute>
                <attribute name="invisible">recurring_invoice or not rent_ok</attribute>
            </xpath>
            <xpath expr="//page[@name='pricing']" position="inside">
                <div class="text-info text-center align-center" invisible="is_pricelist_available">
                    Activate pricelist setting if you want to set specific price rules
                </div>
            </xpath>
            <xpath expr="//page[@name='pricing']/group" position="before">
                <div class="p-2">
                    <label for="list_price" string="Rental Price" />
                    <field colspan="2" name="list_price" string="Rental Price"/>
                    <span>per day</span>
                </div>
            </xpath>
            <xpath expr="//page[@name='pricing']/group" position="attributes">
                <attribute name="invisible">not is_pricelist_available</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit_sales_pricing" model="ir.ui.view">
        <field name="name">product.template.form.inherit.sales.pricing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page name="sales_pricing_rule" string="Pricing" invisible="recurring_invoice or rent_ok or not sale_ok">
                    <xpath expr="//page[@name='pricing']/group" position="before">
                        <div class="p-2">
                            <label for="list_price" string="Sales Price" />
                            <field colspan="2" name="list_price" string="Sales Price"/>
                            per unit
                        </div>
                    </xpath>
                    <xpath expr="//page[@name='pricing']" position="inside">
                        <div class="text-info text-center align-center" invisible="is_pricelist_available">
                            Activate pricelist setting if you want to set specific price rules
                        </div>
                    </xpath>
                    <field name="pricelist_item_ids" invisible="not is_pricelist_available">
                        <list string="Pricelist Rules">
                            <field name="name" string="Apply on"/>
                            <field name="product_id" optional="1" />
                            <field name="price" string="Price"/>
                            <field name="min_quantity" optional="1" />
                            <field name="date_start" optional="1" />
                            <field name="date_end" optional="1" />
                            <field name="company_id" optional="1" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
